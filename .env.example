# ============================================================
# VLESS Reality VPN
# cp .env.example .env
# ============================================================

# --- Standalone mode (default) ---

# SNI for traffic masking
BAIT_SNI=gateway.icloud.com

# VLESS port (default 2053)
LISTEN_PORT=2053

# Number of clients on first generation
CLIENTS_COUNT=10

# Public IP (auto-detected if empty)
# SERVER_IP=

# --- Marzban mode (make install MARZBAN=1) ---

UVICORN_HOST = "0.0.0.0"
UVICORN_PORT = 8000
SUDO_USERNAME = "admin"
SUDO_PASSWORD = "changeme"
XRAY_JSON = "/var/lib/marzban/xray_config.json"
# XRAY_SUBSCRIPTION_URL_PREFIX = "https://your-server-ip:8000"
# TELEGRAM_API_TOKEN = "123456789:AAAA..."
# TELEGRAM_ADMIN_ID = 987654321
